  "httpTemplates": {
    "200_OK": {
      "httpStatus": 200,
      "status": "success",
      "code": 200,
      "message": "Authentication successful"
    },
    "200_LICENSE_READY": {
      "httpStatus": 200,
      "status": "success",
      "code": 200,
      "licenseReady": true,
      "message": "License generated and ready for activation"
    },
    "202_ACCEPTED": {
      "httpStatus": 202,
      "status": "pending",
      "code": 202,
      "errorCode": "APPLICATION_UNDER_REVIEW",
      "title": "Application Under Review",
      "message": "Your application has been received and is under review (1–2 business days)."
    },
    "400_BAD_REQUEST": {
      "httpStatus": 400,
      "status": "error",
      "code": 400,
      "errorCode": "INVALID_VERIFICATION_CODE",
      "title": "Verification Failed",
      "message": "Invalid verification code. Please check and try again."
    },
    "401_INVALID_CREDENTIALS": {
      "httpStatus": 401,
      "status": "error",
      "code": 401,
      "errorCode": "INVALID_CREDENTIALS",
      "title": "Sign In Failed",
      "message": "Invalid credentials. Invalid user account or password. Please verify your credentials or use password recovery."
    },
    "401_SESSION_EXPIRED": {
      "httpStatus": 401,
      "status": "error",
      "code": 401,
      "errorCode": "SESSION_EXPIRED",
      "title": "Session Expired",
      "message": "7-day offline flight authorization has expired. Re-authentication with SkyX backend required."
    },
    "403_CONSOLE_SUSPENDED": {
      "httpStatus": 403,
      "status": "error",
      "code": 403,
      "errorCode": "CONSOLE_SUSPENDED",
      "title": "Device Suspended",
      "message": "This device has been marked replaced or suspended by an administrator. Please sign in using an authorized device or contact SkyX support."
    },
    "403_CONSOLE_UNBOUND": {
      "httpStatus": 403,
      "status": "error",
      "code": 403,
      "errorCode": "CONSOLE_UNBOUND",
      "title": "Device Not Authorized",
      "message": "Your user account is valid, but this device is not authorized for flight operations. Contact your administrator to enroll or reassign this device."
    },
    "404_ACCOUNT_NOT_FOUND": {
      "httpStatus": 404,
      "status": "error",
      "code": 404,
      "errorCode": "ACCOUNT_NOT_FOUND",
      "title": "Account Not Found",
      "message": "No operator account found matching this email."
    },
    "409_ACCOUNT_EXISTS": {
      "httpStatus": 409,
      "status": "error",
      "code": 409,
      "errorCode": "ACCOUNT_EXISTS",
      "title": "Account Exists",
      "message": "An account with this email address already exists."
    },
    "422_FCM_MISMATCH": {
      "httpStatus": 422,
      "status": "error",
      "code": 422,
      "errorCode": "FCM_MISMATCH",
      "title": "FCM UID Mismatch",
      "fcmUid": "1A:2B:3C:4D:5E:6F",
      "airframeSerial": "SKYX-KSN-2026-0842",
      "message": "Aircraft Flight Control Module (FCM UID: 1A:2B:3C:4D:5E:6F) does not match registered airframe serial (SKYX-KSN-2026-0842). Telemetry connection aborted."
    },
    "500_SUBMISSION_FAILED": {
      "httpStatus": 500,
      "status": "error",
      "code": 500,
      "errorCode": "APPLICATION_SUBMISSION_FAILED",
      "title": "Application Sent Failure",
      "message": "Application was submitted, but could not reach the SkyX backend."
    },
    "504_SERVER_TIMEOUT": {
      "httpStatus": 504,
      "status": "error",
      "code": 504,
      "errorCode": "SERVER_TIMEOUT",
      "title": "Server Connection Timeout",
      "message": "Unable to reach SkyX authentication servers. Please verify your internet connection and try again."
    },
    "0_NETWORK_DISCONNECTED": {
      "httpStatus": 0,
      "status": "error",
      "code": 0,
      "errorCode": "NETWORK_UNAVAILABLE",
      "title": "Network Unavailable",
      "message": "Network connection failed. Verify internet link."
    }
  },

  "registration": {
    "triggers": {
      "duplicate@gmail.com": "409_ACCOUNT_EXISTS",
      "duplicate@skyx.aero": "409_ACCOUNT_EXISTS",
      "failed@gmail.com": "500_SUBMISSION_FAILED",
      "failed@skyx.aero": "500_SUBMISSION_FAILED",
      "timeout@gmail.com": "504_SERVER_TIMEOUT",
      "timeout@skyx.aero": "504_SERVER_TIMEOUT"
    },
    "defaultSuccessTemplate": "202_ACCEPTED"
  },

  "passwordRecovery": {
    "validCode": "849201",
    "expirySeconds": 300,
    "triggers": {
      "notfound@gmail.com": "404_ACCOUNT_NOT_FOUND",
      "notfound@skyx.aero": "404_ACCOUNT_NOT_FOUND",
      "timeout@gmail.com": "504_SERVER_TIMEOUT",
      "timeout@skyx.aero": "504_SERVER_TIMEOUT"
    }
  }
